# Server
PORT=5000
NODE_ENV=development
# Comma-separated allowed browser origins
CLIENT_ORIGIN=http://localhost:3000

# MongoDB. For local dev without an installed MongoDB, leave MONGODB_URI unset and
# set USE_MEMORY_DB=true to boot an ephemeral in-memory instance (data is lost on restart).
MONGODB_URI=mongodb://127.0.0.1:27017/abis
USE_MEMORY_DB=false

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h
COOKIE_NAME=abis_token

# Seed (initial accounts). Change before production!
SEED_SECRETARY_USERNAME=secretary
SEED_SECRETARY_PASSWORD=ChangeMe123!
SEED_SECRETARY_FULLNAME=Barangay Secretary
SEED_TREASURER_USERNAME=treasurer
SEED_TREASURER_PASSWORD=ChangeMe123!
SEED_TREASURER_FULLNAME=Barangay Treasurer
SEED_CAPTAIN_USERNAME=captain
SEED_CAPTAIN_PASSWORD=ChangeMe123!
SEED_CAPTAIN_FULLNAME=Punong Barangay
